# --- Database ---
# PostgreSQL. With docker compose, set POSTGRES_PASSWORD (letters and digits) and leave DATABASE_URL commented out:
# the app uses the compose file's db service. Running from source (or another server), set DATABASE_URL.
POSTGRES_PASSWORD=
# DATABASE_URL=postgresql://call_analyzer:password@localhost:5432/call_analyzer
# Connections the app keeps open to it, at most (default 20).
DB_POOL_SIZE=20

# --- Phone system ---
# Where recordings come from and what the softphone signs in to. Built in: govoice. Another phone system is
# connected by adding an adapter in call_analyzer/adapters/telephony/ (see base.py there). Restart after changing it.
TELEPHONY_PROVIDER=govoice

# --- GoVoice (VoIP manager) ---
GOVOICE_BASE_URL=https://otn.govoice.tn:4444
# Filled in automatically when you log in to GoVoice from the app (Settings > Log in to GoVoice).
# Or paste it by hand: DevTools > Network > the "Enregistrement" request > the "Cookie" request header.
GOVOICE_COOKIE=PHPSESSID=xxxxxxxxxxxxxxxx
# Folder that serves the mp3 files. Leave empty to auto-detect it from the Enregistrement page.
GOVOICE_RECORDINGS_DIR=govoice_enreg_1759512535
# Set to false if the server uses a self-signed certificate.
GOVOICE_VERIFY_SSL=true

# --- Softphone ---
# Make and take GoVoice calls in the browser. Each account gets its extension and GoVoice login in Users; the SIP
# username and password are fetched from GoVoice with that login.
# GoVoice's WebRTC WebSocket.
SOFTPHONE_WS_URL=wss://otn.govoice.tn:8089/ws
# SIP domain the extensions register to.
SOFTPHONE_DOMAIN=otn.govoice.tn
# Put in front of the extension to make the SIP username: extension 100 signs in as 1759512535_100.
# Empty: taken from GOVOICE_RECORDINGS_DIR (govoice_enreg_1759512535).
SOFTPHONE_USER_PREFIX=1759512535_
# STUN/TURN servers for the call audio, separated by commas. TURN with a login: turn:user:password@host:3478
SOFTPHONE_ICE_SERVERS=stun:stun.l.google.com:19302

# --- Security ---
# Key that encrypts the passwords saved in the database (softphone logins). Any long random text. Empty: a random key
# is created once in data/secret.key (back it up with the database). Changing it makes the saved passwords unreadable.
SECRET_KEY=

# --- Call desk ---
# Desk calls are matched to their GoVoice recordings by time. If GoVoice's clock runs ahead of this server's (e.g. the
# server is on UTC and GoVoice on Tunisian time), the difference in minutes (e.g. 60; negative if behind).
RECORDING_CLOCK_OFFSET_MINUTES=0
# An agent taking calls who stays on the desk this many minutes without calling anyone is prompted to call (again
# every this many minutes while it lasts). Each time is logged for admins (Operations > KPIs > Idle prompts). 0: off.
DESK_IDLE_PROMPT_MINUTES=5
# Earned breaks: an agent who closes DESK_EARNED_BREAK_CALLS calls is offered a break of DESK_EARNED_BREAK_MINUTES (the
# count starts again after each one they take). It's logged as an "Earned break" pause, shown on the board and the KPIs.
DESK_EARNED_BREAK=false
DESK_EARNED_BREAK_CALLS=20
DESK_EARNED_BREAK_MINUTES=10
# Alerts on the team board (Operations > Team board), 0 turns one off. An agent taking calls but idle (no call, a
# contact served but not dialed, or a call still being closed) for this many minutes:
ALERT_IDLE_MINUTES=10
# A call lasting this many minutes:
ALERT_LONG_CALL_MINUTES=20
# This many unanswered calls in a row for an agent today:
ALERT_NO_ANSWER_STREAK=5
# A sudden drop in contact rate: the minutes of calls compared with each campaign's 7 days before.
ALERT_CONTACT_RATE_WINDOW_MINUTES=60
# How much lower the contact rate must be over those minutes, in percent (40: e.g. 30% of contacts reached instead of 50%).
ALERT_CONTACT_RATE_DROP_PERCENT=40
# The fewest calls closed over those minutes for the contact rate to count (the 7 days before need three times as many).
ALERT_CONTACT_RATE_MIN_CALLS=10
# A callback still waiting this many minutes after it came due:
ALERT_CALLBACK_OVERDUE_MINUTES=15
# A missed incoming call nobody called back this many minutes after it rang:
ALERT_MISSED_CALL_MINUTES=10

# --- CRM ---
# The CRM the call desk takes its leads from and writes call results to: internal (the built-in CRM, kept in the
# app's database; nothing to set up) or twenty. Empty: internal, or twenty when CRM_API_KEY is filled in. Another CRM
# is connected by adding an adapter in call_analyzer/adapters/crm/ (see base.py there).
CRM_PROVIDER=
# How many contacts the call desk loads from the CRM at a time. The queue holds at most this many and loads the next
# batch once it has gone through them; lower it if the CRM fails to answer for larger lists. 0: no limit.
CRM_QUEUE_BATCH=160

# --- CRM (Twenty) ---
# Calls are matched to the CRM contacts with the same phone number (Calls > a call > CRM tab).
CRM_BASE_URL=https://crm.tunisolutions.com
# In Twenty: Settings > APIs & Webhooks > create an API key. Leave empty to turn the CRM tab off.
CRM_API_KEY=
# Set to false if the CRM uses a self-signed certificate.
CRM_VERIFY_SSL=true

# --- WhatsApp ---
# WhatsApp Cloud API, for the call desk's quick actions (price list, how to deposit...: set them up below once
# these are filled). From Meta's App Dashboard > WhatsApp > API Setup. Use a System User's permanent access token
# (Business Settings > System users) with whatsapp_business_messaging and whatsapp_business_management: the
# temporary token shown on API Setup expires after a day.
WHATSAPP_TOKEN=
# The "Phone number ID" of the number messages are sent from (not the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=
# The "WhatsApp Business Account ID", where the approved message templates are: shown under the phone number on
# the app's WhatsApp > API Setup page. Not the Business portfolio's "Business ID" (business.facebook.com > Business
# info), though the app finds the right account from that one if the token can see it.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Graph API version.
WHATSAPP_API_VERSION=v23.0

# --- Speech-to-text ---
# local = free Whisper running on this PC (default); elevenlabs / openai = paid APIs
TRANSCRIBE_PROVIDER=local
# large-v3-turbo (fast, fits a 4 GB GPU) | large-v3 (most accurate, needs more memory) | medium | small
# Tuned for Tunisian Derja: tunisian-large-v3 (Derja + French, most accurate) | arabic-dialectal-turbo (faster)
# (downloaded and converted on first use; needs requirements-convert.txt)
WHISPER_MODEL=large-v3-turbo
# Where models are stored. Empty = data/models inside this project.
WHISPER_MODEL_DIR=
# auto = GPU if available, else CPU | cuda | cpu
WHISPER_DEVICE=auto
# Empty = auto-detect per call. Set "ar" if most calls are in Derja, "fr" if mostly French.
WHISPER_LANGUAGE=
# Example sentence in the style of your calls (Derja in Arabic script, French words in Latin script, product names).
# Strongly recommended: it noticeably improves Derja/French transcription.
WHISPER_PROMPT=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# --- Analysis ---
# claude = Claude only. cursor = Cursor only (needs CURSOR_API_KEY).
# auto = Claude first, then Cursor if the Claude CLI is missing or the session limit is hit.
ANALYSIS_BACKEND=claude
# subscription = uses the Claude Code CLI you're logged into (Pro/Max plan, no API key)
# api = uses ANTHROPIC_API_KEY (pay per token). Used when ANALYSIS_BACKEND is claude or auto.
CLAUDE_BACKEND=subscription
# Servers/Docker with CLAUDE_BACKEND=subscription: run `claude setup-token` on your PC and paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# User API key from Cursor Dashboard → API Keys. Used when ANALYSIS_BACKEND is cursor or auto.
CURSOR_API_KEY=
# Model for Cursor analysis. composer-2.5 is the current default.
CURSOR_MODEL=composer-2.5
# Language the feedback is written in
FEEDBACK_LANGUAGE=English

# --- Voice analysis ---
# true = listen to the recording itself (not just the transcript): an emotion model and loudness/pitch
# measurements, which the analysis turns into a voice tone score for the agent. A pipeline step of its own
# (download, voice, transcribe, analyze). The emotion model is converted once on this server (needs torch:
# pip install -r requirements-voice.txt; Docker build variable INSTALL_VOICE=true) and then runs without torch;
# remote agents download the converted model from here. Without a converted model only loudness and pitch are measured.
VOICE_ANALYSIS=true
# The emotion model, one of the list in Settings (superb/wav2vec2-base-superb-er, Aniemore/wav2vec2-emotion-v1-crosslingual,
# Lajavaness/wav2vec2-lg-xlsr-fr-speech-emotion-recognition). Converted once on first use, or with Install now.
VOICE_MODEL=superb/wav2vec2-base-superb-er

# --- Remote agents ---
# Where transcription runs. host = this server (needs Whisper here). agent = only on connected remote agents:
# PCs running `python -m call_analyzer agent run` (add them on the Agents page); calls wait in a queue until one
# is online. auto = on an agent while one is online, otherwise on this server.
TRANSCRIBE_RUNS_ON=host
# Where the voice analysis runs. Same choices. An agent downloads the converted emotion model from this server.
VOICE_RUNS_ON=host
# Where the analysis (Claude/Cursor) runs. Same choices as above; it can differ from transcription, e.g.
# transcribe on a PC with a GPU and analyze on the server with an API key.
ANALYZE_RUNS_ON=host
# Where people download the Windows agent installer, shown when adding an agent (optional). Or copy the installer
# into the data folder's downloads/ directory and it is offered from this server.
AGENT_DOWNLOAD_URL=

# --- Ongoing mode ---
# true = while the web interface runs, regularly fetch new calls from GoVoice and download, transcribe and
# analyze them automatically (no coaching reports). Takes effect without a restart.
AUTO_PROCESS=false
# Minutes between two automatic runs.
AUTO_PROCESS_MINUTES=5
# Calls to or from these numbers are never downloaded, transcribed or analyzed, e.g. our own agents' phones
# called through the VoIP. Separate them with commas. With or without +216; an extension (101) skips all its calls.
SKIP_NUMBERS=

# --- Sharing & hosting ---
# true = listen on the local network: colleagues can sign in, and open share links without signing in.
# Needs a restart of the UI to take effect. Windows may ask to allow Python through the firewall.
SHARE_ON_LAN=false
UI_PORT=8765
# Address people use to reach the app when it's hosted, e.g. https://calls.example.com (used in share links).
PUBLIC_URL=
# true = only send the login cookie over HTTPS. Turn on when the app is served over HTTPS.
COOKIE_SECURE=false
# How long a sign-in lasts, in days.
SESSION_DAYS=14
# This account is created at startup if it doesn't exist yet. Add more with: python -m call_analyzer user add <name>
ADMIN_USERNAME=
ADMIN_PASSWORD=
